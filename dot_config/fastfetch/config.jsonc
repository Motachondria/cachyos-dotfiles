{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "logo": {
    "type": "builtin",
    "source": "Windows",
    "height": 15,
    "width": 30,
    "padding": {
      "top": 5,
      "left": 3,
      "right": 4
    }
  },

  "modules": [
    "break",

    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐"
    },
    {
      "type": "cpu",
      "key": " CPU",
      "keyColor": "green",
      "showPeCoreCount": true,
      "temp": false
    },
    {
      "type": "CPUUsage",
      "key": "│ ├󰓅",
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": "│ ├󰾲",
      "keyColor": "green",
      "driverSpecific": false,
      "detectionMethod": "pci",
      "temp": false
    },
    {
      "type": "memory",
      "key": "│ ├",
      "keyColor": "green"
    },
    {
      "type": "swap",
      "key": "│ ├󰓡",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "└ └",
      "keyColor": "green",
      "showRegular": true,
      "showExternal": true,
      "showHidden": false,
      "showSubvolumes": false,
      "hideFolders": "/efi:/boot:/boot/*"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },

    "break",

    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Software──────────────────────┐"
    },
    {
      "type": "os",
      "key": "󰍲 OS",
      "keyColor": "yellow"
    },
    {
      "type": "bios",
      "key": "│ ├󰍛",
      "keyColor": "yellow"
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "yellow"
    },
    {
      "type": "font",
      "key": "│ ├",
      "keyColor": "yellow"
    },
    {
      "type": "Processes",
      "key": "│ ├󰊠",
      "keyColor": "yellow"
    },
    {
      "type": "Btrfs",
      "key": "└ └󰋊",
      "keyColor": "yellow"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },

    "break",

    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────────Uptime / Age / DT────────────────────┐"
    },
    {
      "type": "uptime",
      "key": "󰅐 Uptime",
      "keyColor": "magenta"
    },
    {
      "type": "datetime",
      "key": "│ ├",
      "keyColor": "magenta"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└─────────────────────────────────────────────────────────┘"
    },

    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
